{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acme-air",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "acmeair.thestagingshire.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
